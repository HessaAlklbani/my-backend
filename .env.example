PORT=4000
CORS_ORIGINS=http://localhost:3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=your_database_user
DB_PASSWORD=replace_with_a_new_secret
DB_NAME=watersport_db

DASHBOARD_PASSWORD=replace_with_a_long_random_password

# Use UPLOAD_STORAGE=r2 on Render; keep local development on local storage.
UPLOAD_STORAGE=local
R2_ACCOUNT_ID=replace_with_cloudflare_account_id
R2_ACCESS_KEY_ID=replace_with_r2_access_key_id
R2_SECRET_ACCESS_KEY=replace_with_r2_secret_access_key
R2_BUCKET_NAME=seawaves-uploads
